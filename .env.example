# Copy to .env and fill in; .env is never committed.

# Required by compose.yaml.
EMS_MASTER_KEY=
EMS_ENCIPHER_KEY=
EMS_ENCIPHER_IV=
EMS_BOOTSTRAP_CORS_ORIGINS=

# Telegram user id of the deployment owner; empty means no owner.
EMS_TG_OWNER_ID=

# Development bot and supergroup for ems-runtime/tests/telegram_sandbox.rs;
# the live tests are skipped while either is empty.
EMS_TG_DEV_BOT_TOKEN=
EMS_TG_DEV_GROUP_ID=
